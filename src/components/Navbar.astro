<nav
  id="navbar"
  class="fixed top-0 left-0 w-full z-50 glass shadow-md transition-all duration-300"
>
  <div class="container mx-auto flex justify-between items-center py-3 px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/logo.png"
        alt="Don Vicente - Servicios Integrales"
        class="h-12 w-auto transition-transform duration-300"
      />
    </a>

    <!-- Menú desktop centrado -->
    <ul
      id="navMenu"
      class="hidden md:flex flex-col md:flex-row gap-2 md:gap-2 text-dv-primary font-medium md:items-center absolute md:static glass md:bg-transparent top-20 left-4 right-4 md:w-auto px-4 md:px-0 py-6 md:py-0 rounded-2xl md:rounded-none shadow-md md:shadow-none list-none"
    >
      <li>
        <a
          href="/"
          class="nav-link px-4 py-2.5 rounded-xl transition-all duration-300 hover:bg-white/60 hover:text-dv-secondary active:scale-95"
        >
          Inicio
        </a>
      </li>
      <li>
        <a
          href="/servicios"
          class="nav-link px-4 py-2.5 rounded-xl transition-all duration-300 hover:bg-white/60 hover:text-dv-secondary active:scale-95"
        >
          Servicios
        </a>
      </li>
      <li>
        <a
          href="/nosotros"
          class="nav-link px-4 py-2.5 rounded-xl transition-all duration-300 hover:bg-white/60 hover:text-dv-secondary active:scale-95"
        >
          Nosotros
        </a>
      </li>
      <li>
        <a
          href="/clientes"
          class="nav-link px-4 py-2.5 rounded-xl transition-all duration-300 hover:bg-white/60 hover:text-dv-secondary active:scale-95"
        >
          Clientes
        </a>
      </li>
      <li>
        <a
          href="/faq"
          class="nav-link px-4 py-2.5 rounded-xl transition-all duration-300 hover:bg-white/60 hover:text-dv-secondary active:scale-95"
        >
          Preguntas
        </a>
      </li>
    </ul>

    <!-- Botón hamburguesa y CTA -->
    <div class="flex items-center gap-3">
      <a
        href="/contacto"
        class="hidden md:flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-dv-primary text-white font-semibold shadow-sm transition-all duration-300 hover:shadow-md active:scale-95"
      >
        Contacto
      </a>

      <button
        id="menuToggle"
        class="md:hidden text-dv-primary focus:outline-none focus:ring-2 focus:ring-dv-primary rounded-xl p-3 transition-all hover:bg-white/70 active:scale-95"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="navMenu"
      >
        <svg
          id="menuIcon"
          class="w-6 h-6 transition-transform duration-300"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path class="menu-open" d="M4 6h16M4 12h16M4 18h16"></path>
          <path class="menu-close hidden" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <script is:inline>
    const toggle = document.getElementById("menuToggle");
    const menu = document.getElementById("navMenu");
    const menuIcon = document.getElementById("menuIcon");
    const menuOpen = menuIcon.querySelector(".menu-open");
    const menuClose = menuIcon.querySelector(".menu-close");
    const navbar = document.getElementById("navbar");

    // Navbar al hacer scroll
    let lastScroll = 0;
    window.addEventListener("scroll", () => {
      const currentScroll = window.pageYOffset;

      if (currentScroll > 100) {
        navbar.style.backdropFilter = "blur(20px)";
        navbar.style.background = "rgba(255, 255, 255, 0.85)";
        navbar.style.boxShadow = "0 10px 40px rgba(0, 0, 0, 0.1)";
      } else {
        navbar.style.backdropFilter = "blur(12px)";
        navbar.style.background = "rgba(255, 255, 255, 0.7)";
        navbar.style.boxShadow = "0 8px 32px rgba(31, 38, 135, 0.15)";
      }

      lastScroll = currentScroll;
    });

    toggle.addEventListener("click", () => {
      const isExpanded = menu.classList.contains("hidden");
      menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", isExpanded ? "true" : "false");

      // Cambiar icono
      if (isExpanded) {
        menuOpen.classList.add("hidden");
        menuClose.classList.remove("hidden");
        menuIcon.style.transform = "rotate(90deg)";
      } else {
        menuOpen.classList.remove("hidden");
        menuClose.classList.add("hidden");
        menuIcon.style.transform = "rotate(0deg)";
      }
    });

    // Cerrar menú al hacer click en un enlace (móvil)
    const navLinks = menu.querySelectorAll("a");
    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 768) {
          menu.classList.add("hidden");
          toggle.setAttribute("aria-expanded", "false");
          menuOpen.classList.remove("hidden");
          menuClose.classList.add("hidden");
          menuIcon.style.transform = "rotate(0deg)";
        }
      });
    });

    // Highlight active page
    const currentPath = window.location.pathname;
    navLinks.forEach((link) => {
      if (
        link.getAttribute("href") === currentPath ||
        (currentPath === "/" && link.getAttribute("href") === "/") ||
        (currentPath !== "/" &&
          link.getAttribute("href") !== "/" &&
          currentPath.startsWith(link.getAttribute("href")))
      ) {
        link.classList.add("bg-white/60", "text-dv-secondary");
      }
    });
  </script>

  <style>
    .nav-link {
      position: relative;
    }

    .nav-link::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%) scaleX(0);
      width: 80%;
      height: 2px;
      background: linear-gradient(to right, #002a5c, #d71920);
      transition: transform 0.3s ease;
    }

    .nav-link:hover::after {
      transform: translateX(-50%) scaleX(1);
    }

    @media (max-width: 768px) {
      .nav-link::after {
        display: none;
      }
    }
  </style>
</nav>
