---
import "swiper/css";
import "swiper/css/effect-fade";
import "swiper/css/navigation";
import "swiper/css/pagination";

const slides = [
    {
        title: "Soluciones Integrales que Impulsan tu Operación",
        subtitle:
            "Servicios profesionales para la industria acuícola y pesquera en el sur de Chile",
        image: "/images/industrial.webp", // Fallback if no specific image
        gradient: "from-blue-900/90 to-slate-900/90",
        primaryAction: { text: "Solicitar Cotización", href: "/contacto" },
        secondaryAction: { text: "Ver Servicios", href: "/servicios" },
    },
    {
        title: "Transporte de Personal Seguro y Confiable",
        subtitle:
            "Flota moderna y conductores profesionales para el traslado de tu equipo humano en Aysén",
        image: "/images/transportepersonal.webp",
        gradient: "from-blue-900/80 via-blue-800/80 to-slate-900/80",
        primaryAction: { text: "Cotizar Transporte", href: "/contacto" },
        secondaryAction: { text: "Más Información", href: "/servicios" },
    },
    {
        title: "Servicios de Aseo y Control de Plagas",
        subtitle:
            "Certificación MINSAL y estándares sanitarios para plantas procesadoras y oficinas",
        image: "/images/plagascontrol.webp",
        gradient: "from-slate-900/80 via-red-900/70 to-slate-900/80",
        primaryAction: { text: "Agendar Visita", href: "/contacto" },
        secondaryAction: { text: "Ver Certificaciones", href: "/nosotros" },
    },
];
---

<div class="relative w-full h-[85vh] overflow-hidden">
    <div class="swiper mySwiper h-full w-full">
        <div class="swiper-wrapper">
            {
                slides.map((slide, i) => {
                    // Solo el primer slide lleva H1; los demás usan H2 para que la página tenga un único H1.
                    const Heading = i === 0 ? "h1" : "h2";
                    return (
                    <div class="swiper-slide relative">
                        {/* Background Image with Overlay */}
                        <div class="absolute inset-0">
                            <div
                                class={`absolute inset-0 bg-gradient-to-br ${slide.gradient} z-10`}
                            />
                            <img
                                src={slide.image}
                                alt={slide.title}
                                class="w-full h-full object-cover"
                            />
                        </div>

                        {/* Content Content - Centered */}
                        <div class="relative z-20 container mx-auto px-6 h-full flex flex-col justify-center items-center text-center">
                            <div class="max-w-4xl opacity-0 translate-y-8 animate-slide-content">
                                <div class="inline-block glass-dark px-6 py-2 rounded-full text-sm font-bold text-blue-300 mb-6 border border-white/10">
                                    <span class="inline-block w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse" />
                                    Servicios Disponibles 24/7
                                </div>

                                <Heading class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white mb-6 tracking-tight leading-tight">
                                    {slide.title}
                                </Heading>

                                <p class="text-lg md:text-2xl text-gray-200 mb-10 leading-relaxed max-w-2xl mx-auto">
                                    {slide.subtitle}
                                </p>

                                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                                    <a
                                        href={slide.primaryAction.href}
                                        class="btn-primary-lg shadow-xl shadow-blue-500/20"
                                    >
                                        {slide.primaryAction.text}
                                    </a>
                                    <a
                                        href={slide.secondaryAction.href}
                                        class="px-8 py-4 rounded-xl font-semibold bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/20 transition-all duration-300 hover:scale-105"
                                    >
                                        {slide.secondaryAction.text}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    );
                })
            }
        </div>
        <div class="swiper-pagination"></div>
        <div
            class="swiper-button-next text-white/50 hover:text-white transition-colors"
        >
        </div>
        <div
            class="swiper-button-prev text-white/50 hover:text-white transition-colors"
        >
        </div>
    </div>
</div>

<style>
    .glass-dark {
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
    }

    /* Custom Swiper Styles */
    :global(.swiper-pagination-bullet) {
        background: white;
        opacity: 0.5;
        width: 10px;
        height: 10px;
        transition: all 0.3s ease;
    }
    :global(.swiper-pagination-bullet-active) {
        opacity: 1;
        width: 30px;
        border-radius: 5px;
        background: #3b82f6; /* DV Primary equivalent */
    }

    :global(.swiper-button-next:after),
    :global(.swiper-button-prev:after) {
        font-size: 2rem;
        font-weight: bold;
    }

    /* Animation for content entering */
    .animate-slide-content {
        animation: slideUpFade 0.8s ease-out forwards;
        animation-delay: 0.3s;
    }

    @keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Reset animation on slide change - managed via JS usually, 
     but CSS keyframes run on mount. 
     For simple Astro implementation, we might stick to CSS or add JS listener.
  */
</style>

<script>
    import Swiper from "swiper";
    import {
        Autoplay,
        EffectFade,
        Navigation,
        Pagination,
    } from "swiper/modules";
    import { gsap } from "gsap";

    const initSlider = () => {
        const swiper = new Swiper(".mySwiper", {
            modules: [Autoplay, EffectFade, Navigation, Pagination],
            effect: "fade",
            speed: 1000,
            loop: true,
            autoplay: {
                delay: 5000,
                disableOnInteraction: false,
            },
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            on: {
                slideChangeTransitionStart: function () {
                    // Animate out current slide content
                    const currentSlide = this.slides[this.activeIndex];
                    const content = currentSlide?.querySelector('.animate-slide-content');
                    
                    if (content) {
                        gsap.fromTo(content, 
                            {
                                opacity: 0,
                                y: 50,
                                scale: 0.95
                            },
                            {
                                opacity: 1,
                                y: 0,
                                scale: 1,
                                duration: 1,
                                ease: "power3.out",
                                delay: 0.2
                            }
                        );

                        // Animate buttons with stagger
                        const buttons = content.querySelectorAll('a');
                        gsap.fromTo(buttons,
                            {
                                opacity: 0,
                                y: 20
                            },
                            {
                                opacity: 1,
                                y: 0,
                                duration: 0.6,
                                stagger: 0.1,
                                ease: "power2.out",
                                delay: 0.8
                            }
                        );

                        // Animate badge
                        const badge = content.querySelector('.glass-dark');
                        if (badge) {
                            gsap.fromTo(badge,
                                {
                                    opacity: 0,
                                    scale: 0.8
                                },
                                {
                                    opacity: 1,
                                    scale: 1,
                                    duration: 0.5,
                                    ease: "back.out(1.7)",
                                    delay: 0.3
                                }
                            );
                        }
                    }
                }
            }
        });

        // Initial animation for first slide
        setTimeout(() => {
            const firstSlide = document.querySelector('.swiper-slide-active .animate-slide-content');
            if (firstSlide) {
                gsap.fromTo(firstSlide,
                    {
                        opacity: 0,
                        y: 50,
                        scale: 0.95
                    },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "power3.out"
                    }
                );
            }
        }, 100);
    };

    // Run on load
    initSlider();

    // Support Astro View Transitions if enabled later
    document.addEventListener("astro:page-load", initSlider);
</script>
