---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Servicios para Acuicultura y Pesca - Don Vicente Melinka"
  description="Transporte de personal y carga, aseo industrial, control de plagas MINSAL y operarios para la industria acuícola y pesquera de Aysén."
>
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden min-h-[50vh] flex items-center mb-16"
  >
    <div
      class="absolute inset-0 bg-gradient-to-br from-blue-500/10 via-transparent to-red-500/10 -z-10"
    >
    </div>
    <div
      class="absolute top-10 right-10 w-64 h-64 bg-blue-400/20 rounded-full blur-3xl -z-10"
    >
    </div>

    <div class="container mx-auto px-6 text-center">
      <div
        class="inline-block glass px-6 py-3 rounded-full text-sm font-bold text-dv-primary mb-6 animate-fade-in"
      >
        <span
          class="inline-block w-2 h-2 bg-dv-secondary rounded-full mr-2 animate-pulse"
        ></span>
        Servicios Integrales
      </div>

      <h1
        class="text-5xl md:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-dv-primary via-blue-600 to-dv-primary mb-6 tracking-tight leading-tight animate-fade-in animate-delay-100"
      >
        Transporte, Aseo y Control de Plagas en Aysén
      </h1>

      <p
        class="text-xl md:text-2xl text-gray-700 max-w-3xl mx-auto leading-relaxed animate-fade-in animate-delay-200"
      >
        Servicios profesionales para la <span
          class="font-semibold text-dv-primary"
          >industria acuícola y pesquera</span
        > en el sur de Chile
      </p>
    </div>
  </section>

  <!-- Servicio 1: Transporte -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <div class="glass-card scroll-reveal">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <div
                class="rounded-3xl overflow-hidden shadow-2xl mx-auto md:mx-0 mb-6"
