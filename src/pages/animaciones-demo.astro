---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Demo de Animaciones GSAP - Don Vicente"
  description="Demostración de las animaciones avanzadas con GSAP implementadas en el sitio."
>
  <!-- Hero Section -->
  <section class="py-20 text-center">
    <h1 class="text-5xl font-bold text-dv-primary mb-4 text-reveal">
      Animaciones GSAP Implementadas
    </h1>
    <p class="text-xl text-gray-700 scroll-reveal">
      Explora todas las animaciones disponibles en el sitio
    </p>
  </section>

  <!-- Scroll Reveal Animations -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        1. Scroll Reveal (Fade In Up)
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="glass-card scroll-reveal">
          <h3 class="font-bold text-lg mb-2">Tarjeta 1</h3>
          <p class="text-gray-700">Esta tarjeta aparece con un fade in up al hacer scroll</p>
        </div>
        <div class="glass-card scroll-reveal">
          <h3 class="font-bold text-lg mb-2">Tarjeta 2</h3>
          <p class="text-gray-700">Animación suave y profesional</p>
        </div>
        <div class="glass-card scroll-reveal">
          <h3 class="font-bold text-lg mb-2">Tarjeta 3</h3>
          <p class="text-gray-700">Perfecta para mostrar contenido</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Slide Animations -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        2. Slide Animations
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="glass-card slide-left">
          <h3 class="font-bold text-lg mb-2">← Desde la Izquierda</h3>
          <p class="text-gray-700">Esta tarjeta se desliza desde la izquierda</p>
        </div>
        <div class="glass-card slide-right">
          <h3 class="font-bold text-lg mb-2">Desde la Derecha →</h3>
          <p class="text-gray-700">Esta tarjeta se desliza desde la derecha</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Scale In Animation -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        3. Scale In (con efecto bounce)
      </h2>
      <div class="flex justify-center">
        <div class="glass-card scale-in max-w-md">
          <div class="text-6xl mb-4 text-center">🎯</div>
          <h3 class="font-bold text-lg mb-2 text-center">Efecto de Escala</h3>
          <p class="text-gray-700">Esta tarjeta aparece con un efecto de escala y rebote</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stagger Grid -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        4. Stagger Grid (animación escalonada)
      </h2>
      <div class="grid md:grid-cols-4 gap-6 stagger-grid">
        <div class="glass-card p-6 text-center">
          <div class="text-3xl mb-2">🚀</div>
          <p class="font-semibold">Item 1</p>
        </div>
        <div class="glass-card p-6 text-center">
          <div class="text-3xl mb-2">⚡</div>
          <p class="font-semibold">Item 2</p>
        </div>
        <div class="glass-card p-6 text-center">
          <div class="text-3xl mb-2">🎨</div>
          <p class="font-semibold">Item 3</p>
        </div>
        <div class="glass-card p-6 text-center">
          <div class="text-3xl mb-2">✨</div>
          <p class="font-semibold">Item 4</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Counter Animation -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        5. Counter Animation
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="glass-card text-center">
          <div class="text-5xl font-bold text-dv-primary mb-2">
            <span class="counter" data-target="150" data-duration="2">0</span>+
          </div>
          <p class="text-gray-700">Clientes Satisfechos</p>
        </div>
        <div class="glass-card text-center">
          <div class="text-5xl font-bold text-dv-primary mb-2">
            <span class="counter" data-target="10" data-duration="2">0</span>
          </div>
          <p class="text-gray-700">Años de Experiencia</p>
        </div>
        <div class="glass-card text-center">
          <div class="text-5xl font-bold text-dv-primary mb-2">
            <span class="counter" data-target="500" data-duration="2.5">0</span>+
          </div>
          <p class="text-gray-700">Proyectos Completados</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hover Effects -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        6. Efectos de Hover Interactivos
      </h2>
      
      <!-- Card Tilt -->
      <div class="mb-12">
        <h3 class="text-xl font-bold text-gray-800 mb-4">Card Tilt (Efecto 3D)</h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="glass-card card-tilt">
            <h4 class="font-bold mb-2">Pasa el mouse aquí</h4>
            <p class="text-gray-700">Efecto de inclinación 3D</p>
          </div>
          <div class="glass-card card-tilt">
            <h4 class="font-bold mb-2">Interactivo</h4>
            <p class="text-gray-700">Sigue el movimiento del mouse</p>
          </div>
          <div class="glass-card card-tilt">
            <h4 class="font-bold mb-2">Suave y fluido</h4>
            <p class="text-gray-700">Animación con GSAP</p>
          </div>
        </div>
      </div>

      <!-- Magnetic Buttons -->
      <div class="mb-12">
        <h3 class="text-xl font-bold text-gray-800 mb-4">Botones Magnéticos</h3>
        <div class="flex gap-4 justify-center">
          <button class="btn-primary btn-magnetic ripple-effect">
            Botón Magnético 1
          </button>
          <button class="px-6 py-3 bg-dv-secondary text-white rounded-lg font-semibold btn-magnetic ripple-effect">
            Botón Magnético 2
          </button>
        </div>
      </div>

      <!-- Image Zoom -->
      <div class="mb-12">
        <h3 class="text-xl font-bold text-gray-800 mb-4">Image Zoom</h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="overflow-hidden rounded-lg shadow-lg">
            <img src="/images/industrial.jpg" alt="Demo" class="img-zoom w-full h-64 object-cover" />
          </div>
          <div class="overflow-hidden rounded-lg shadow-lg">
            <img src="/images/transportepersonal.jpg" alt="Demo" class="img-zoom w-full h-64 object-cover" />
          </div>
          <div class="overflow-hidden rounded-lg shadow-lg">
            <img src="/images/aseo.jpg" alt="Demo" class="img-zoom w-full h-64 object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rotate In -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        7. Rotate In Animation
      </h2>
      <div class="flex justify-center">
        <div class="glass-card rotate-in max-w-md">
          <div class="text-6xl mb-4 text-center">🔄</div>
          <h3 class="font-bold text-lg mb-2 text-center">Rotación Suave</h3>
          <p class="text-gray-700 text-center">Esta tarjeta rota al aparecer</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Float Elements -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        8. Elementos Flotantes
      </h2>
      <div class="flex justify-center gap-8">
        <div class="float-element text-6xl">☁️</div>
        <div class="float-element text-6xl" style="animation-delay: 0.5s;">🎈</div>
        <div class="float-element text-6xl" style="animation-delay: 1s;">🪁</div>
      </div>
    </div>
  </section>

  <!-- Progress Bars -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-dv-primary mb-8 text-center">
        9. Barras de Progreso Animadas
      </h2>
      <div class="max-w-2xl mx-auto space-y-6">
        <div>
          <div class="flex justify-between mb-2">
            <span class="font-semibold">Transporte</span>
            <span>95%</span>
          </div>
          <div class="progress-bar w-full h-4 bg-gray-200 rounded-full overflow-hidden" data-percentage="95">
            <div class="progress-fill h-full bg-gradient-to-r from-dv-primary to-blue-600"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between mb-2">
            <span class="font-semibold">Aseo Industrial</span>
            <span>88%</span>
          </div>
          <div class="progress-bar w-full h-4 bg-gray-200 rounded-full overflow-hidden" data-percentage="88">
            <div class="progress-fill h-full bg-gradient-to-r from-green-500 to-green-700"></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between mb-2">
            <span class="font-semibold">Control de Plagas</span>
            <span>92%</span>
          </div>
          <div class="progress-bar w-full h-4 bg-gray-200 rounded-full overflow-hidden" data-percentage="92">
            <div class="progress-fill h-full bg-gradient-to-r from-dv-secondary to-red-700"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Guide Section -->
  <section class="py-16 bg-gradient-to-br from-blue-50 to-white">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto glass-card">
        <h2 class="text-3xl font-bold text-dv-primary mb-6">
          📚 Guía de Uso
        </h2>
        <div class="space-y-4 text-gray-700">
          <div>
            <h3 class="font-bold text-lg mb-2">Clases disponibles:</h3>
            <ul class="list-disc list-inside space-y-1 ml-4">
              <li><code class="bg-gray-100 px-2 py-1 rounded">.scroll-reveal</code> - Fade in up al hacer scroll</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.slide-left</code> - Deslizar desde la izquierda</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.slide-right</code> - Deslizar desde la derecha</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.scale-in</code> - Escala con bounce</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.stagger-grid</code> - Grid con animación escalonada</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.card-tilt</code> - Efecto 3D en hover</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.btn-magnetic</code> - Botón magnético</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.img-zoom</code> - Zoom en imágenes al hover</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.rotate-in</code> - Rotación al aparecer</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.float-element</code> - Flotación continua</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.counter</code> - Contador animado (usa data-target y data-duration)</li>
              <li><code class="bg-gray-100 px-2 py-1 rounded">.progress-bar</code> - Barra de progreso (usa data-percentage)</li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-2 mt-6">Ejemplo de uso:</h3>
            <pre class="bg-gray-900 text-green-400 p-4 rounded-lg overflow-x-auto text-sm"><code>&lt;div class="glass-card scroll-reveal"&gt;
  Contenido que aparece al hacer scroll
&lt;/div&gt;

&lt;button class="btn-primary btn-magnetic ripple-effect"&gt;
  Botón interactivo
&lt;/button&gt;

&lt;span class="counter" data-target="100" data-duration="2"&gt;0&lt;/span&gt;</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="container mx-auto px-6 text-center">
      <div class="scroll-reveal">
        <h2 class="text-4xl font-bold text-dv-primary mb-6">
          ¿Listo para implementar?
        </h2>
        <p class="text-xl text-gray-700 mb-8">
          Usa estas clases en cualquier parte de tu sitio
        </p>
        <a href="/" class="btn-primary btn-magnetic ripple-effect">
          Volver al Inicio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
