---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Página No Encontrada - Don Vicente"
    description="La página que buscas no existe. Vuelve al inicio o explora nuestros servicios."
>
    <section class="min-h-[70vh] flex items-center justify-center">
        <div class="container mx-auto px-6">
            <div class="max-w-3xl mx-auto text-center">
                <!-- Número 404 grande -->
                <div class="mb-8">
                    <h1
                        class="text-9xl md:text-[12rem] font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-dv-primary via-blue-600 to-dv-secondary mb-4"
                        style="padding-top: 0.2em; padding-bottom: 0.25em;"
                    >
                        404
                    </h1>
                </div>

                <!-- Icono -->
                <div class="text-8xl mb-6 animate-bounce-slow">🔍</div>

                <!-- Mensaje -->
                <h2 class="text-3xl md:text-4xl font-bold text-dv-primary mb-4">
                    Página No Encontrada
                </h2>
                <p class="text-xl text-gray-700 mb-8 leading-relaxed">
                    Lo sentimos, la página que buscas no existe o ha sido
                    movida.
                </p>

                <!-- Botones -->
                <div
                    class="flex flex-col sm:flex-row gap-4 justify-center mb-12"
                >
                    <a
                        href="/"
                        class="btn-primary inline-flex items-center justify-center gap-3"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                            ></path>
                        </svg>
                        <span>Volver al Inicio</span>
                    </a>
                    <a
                        href="/servicios"
                        class="px-8 py-4 rounded-xl font-semibold glass hover:bg-white/90 text-dv-primary transition-all duration-300 hover:scale-105 hover:shadow-2xl inline-flex items-center justify-center gap-3"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                            ></path>
                        </svg>
                        <span>Ver Servicios</span>
                    </a>
                </div>

                <!-- Enlaces útiles -->
                <div class="glass-card inline-block">
                    <h3 class="text-lg font-bold text-dv-primary mb-4">
                        Enlaces Útiles
                    </h3>
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <a
                            href="/nosotros"
                            class="text-gray-700 hover:text-dv-secondary transition-colors"
                        >
                            Nosotros
                        </a>
                        <a
                            href="/clientes"
                            class="text-gray-700 hover:text-dv-secondary transition-colors"
                        >
                            Clientes
                        </a>
                        <a
                            href="/contacto"
                            class="text-gray-700 hover:text-dv-secondary transition-colors"
                        >
                            Contacto
                        </a>
                        <a
                            href="/faq"
                            class="text-gray-700 hover:text-dv-secondary transition-colors"
                        >
                            Preguntas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
