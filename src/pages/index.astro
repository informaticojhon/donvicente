---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="Don Vicente - Servicios Acuícolas y Transporte en Melinka, Aysén"
  description="Transporte de personal, aseo industrial y control de plagas MINSAL para la industria acuícola en Melinka y Aysén. Más de 10 años de experiencia."
>
  <!-- Hero principal mejorado -->
  <HeroSlider />

  <!-- Servicios Principales Mejorados -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h2 class="section-title text-center mb-4">Nuestros Servicios</h2>
      <p class="section-subtitle text-center mb-16">
        Soluciones completas para tu negocio
      </p>

      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Transporte -->
        <div
          class="glass-card p-8 text-center group hover:shadow-md transition-all duration-300"
        >
          <div
            class="w-full h-48 mb-6 overflow-hidden rounded-2xl transition-transform duration-500 shadow-sm"
          >
            <img
              src="/images/carga.webp"
              loading="lazy"
              decoding="async"
              alt="Transporte de Carga y Personal"
              class="w-full h-full object-cover"
            />
          </div>
          <h3 class="text-2xl font-bold text-dv-primary mb-3">Transporte</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Traslado seguro de personal y carga en zonas urbanas y rurales del
            sur de Chile.
          </p>
          <ul class="text-sm text-left text-gray-600 space-y-2 mb-6">
            <li class="flex items-center gap-2">
              <span class="text-blue-600">✓</span> Transporte de personal
            </li>
            <li class="flex items-center gap-2">
              <span class="text-blue-600">✓</span> Carga y logística
            </li>
            <li class="flex items-center gap-2">
              <span class="text-blue-600">✓</span> Servicio puntual
            </li>
          </ul>
          <a
            href="/servicios"
            class="text-dv-primary font-semibold hover:text-dv-secondary transition-colors inline-flex items-center gap-2"
          >
            Ver más
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Aseo Industrial -->
        <div
          class="glass-card p-8 text-center group hover:shadow-md transition-all duration-300"
        >
          <div
            class="w-full h-48 mb-6 overflow-hidden rounded-2xl shadow-sm"
          >
            <img
              src="/images/aseo.webp"
              loading="lazy"
              decoding="async"
              alt="Servicio de Aseo Industrial"
              class="w-full h-full object-cover"
            />
          </div>
          <h3 class="text-2xl font-bold text-dv-primary mb-3">
            Aseo Industrial
          </h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Limpieza profunda y profesional para empresas, instituciones y
            espacios comerciales.
          </p>
          <ul class="text-sm text-left text-gray-600 space-y-2 mb-6">
            <li class="flex items-center gap-2">
              <span class="text-green-600">✓</span> Limpieza institucional
            </li>
            <li class="flex items-center gap-2">
              <span class="text-green-600">✓</span> Equipos certificados
            </li>
            <li class="flex items-center gap-2">
              <span class="text-green-600">✓</span> Personal capacitado
            </li>
          </ul>
          <a
            href="/servicios"
            class="text-dv-primary font-semibold hover:text-dv-secondary transition-colors inline-flex items-center gap-2"
          >
            Ver más
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Control de Plagas -->
        <div
          class="glass-card p-8 text-center group hover:shadow-md transition-all duration-300"
        >
          <div
            class="w-full h-48 mb-6 overflow-hidden rounded-2xl shadow-sm relative"
          >
            <img
              src="/images/cplagas.webp"
              loading="lazy"
              decoding="async"
              alt="Control de Plagas Certificado"
              class="w-full h-full object-cover"
            />
            <!-- Badge MINSAL -->
            <div
              class="absolute top-2 right-2 bg-yellow-400 text-yellow-900 text-xs font-bold px-3 py-1 rounded-full shadow-sm z-10"
            >
              MINSAL
            </div>
          </div>
          <h3 class="text-2xl font-bold text-dv-primary mb-3">
            Control de Plagas
          </h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Soluciones efectivas y certificadas para eliminación y prevención de
            plagas.
          </p>
          <ul class="text-sm text-left text-gray-600 space-y-2 mb-6">
            <li class="flex items-center gap-2">
              <span class="text-red-600">✓</span> Certificación MINSAL
            </li>
            <li class="flex items-center gap-2">
              <span class="text-red-600">✓</span> Métodos seguros
            </li>
            <li class="flex items-center gap-2">
              <span class="text-red-600">✓</span> Prevención continua
            </li>
          </ul>
          <a
            href="/servicios"
            class="text-dv-primary font-semibold hover:text-dv-secondary transition-colors inline-flex items-center gap-2"
          >
            Ver más
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sectores que Atendemos -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <h2 class="section-title mb-4">Sectores que Atendemos</h2>
      <p class="section-subtitle mb-16">
        Experiencia multisectorial en toda la región
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- Pesca y Acuicultura -->
        <div class="glass-card group">
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-16 h-16 bg-dv-primary rounded-xl flex items-center justify-center text-4xl shadow-sm"
            >
              <Icon name="factory" class="w-8 h-8 text-white" />
            </div>
            <h3 class="text-xl font-bold text-dv-primary">
              Pesca y Acuicultura
            </h3>
          </div>
          <p class="text-sm text-gray-700 leading-relaxed">
            Servicios especializados para empresas pesqueras y plantas
            procesadoras.
          </p>
        </div>

        <!-- Educación -->
        <div
          class="glass-card group"
        >
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-16 h-16 bg-dv-primary rounded-xl flex items-center justify-center text-4xl shadow-sm"
            >
              <Icon name="school" class="w-8 h-8 text-white" />
            </div>
            <h3 class="text-xl font-bold text-dv-primary">Educación</h3>
          </div>
          <p class="text-sm text-gray-700 leading-relaxed">
            Servicios de control de plagas.
          </p>
        </div>

        <!-- Empresas Privadas -->
        <div
          class="glass-card group"
        >
          <div class="flex items-center gap-4 mb-4">
            <div
              class="w-16 h-16 bg-dv-primary rounded-xl flex items-center justify-center text-4xl shadow-sm"
            >
              <Icon name="building-2" class="w-8 h-8 text-white" />
            </div>
            <h3 class="text-xl font-bold text-dv-primary">Empresas Privadas</h3>
          </div>
          <p class="text-sm text-gray-700 leading-relaxed">
            Soluciones integrales para comercio y servicios.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Presencia Regional -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <h2 class="section-title mb-4">Presencia Regional</h2>
      <p class="section-subtitle mb-16">Servicios en toda la Región de Aysén</p>

      <div class="max-w-5xl mx-auto">
        <div class="glass-card">
          <div class="text-center mb-8">
            <h3 class="text-2xl font-bold text-dv-primary mb-2">
              Cobertura Regional Completa
            </h3>
            <p class="text-gray-700">
              Operamos desde Melinka hacia toda la Región de Aysén
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-6 mb-8">
            <div class="text-center">
              <div
                class="w-16 h-16 bg-dv-primary rounded-full flex items-center justify-center mx-auto mb-3 text-white text-2xl font-bold shadow-sm"
              >
                <Icon name="map-pin" class="w-7 h-7 text-white" />
              </div>
              <h4 class="font-bold text-dv-primary mb-1">Base Principal</h4>
              <p class="text-sm text-gray-700">Melinka</p>
            </div>
            <div class="text-center">
              <div
                class="w-16 h-16 bg-dv-primary rounded-full flex items-center justify-center mx-auto mb-3 text-white text-2xl font-bold shadow-sm"
              >
                <span>5</span>+
              </div>
              <h4 class="font-bold text-dv-primary mb-1">Comunas</h4>
              <p class="text-sm text-gray-700">Atendidas</p>
            </div>
            <div class="text-center">
              <div
                class="w-16 h-16 bg-dv-primary rounded-full flex items-center justify-center mx-auto mb-3 text-white text-2xl font-bold shadow-sm"
              >
                <span>100</span>%
              </div>
              <h4 class="font-bold text-dv-primary mb-1">Cobertura</h4>
              <p class="text-sm text-gray-700">Regional</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final Mejorado -->
  <section class="py-20 relative overflow-hidden">
    <!-- Fondo con gradiente -->
    <div
      class="absolute inset-0 bg-blue-50 -z-10"
    >
    </div>

    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto glass-card text-center">
        <h2 class="text-3xl md:text-5xl font-bold text-dv-primary mb-6">
          ¿Listo para comenzar?
        </h2>
        <p
          class="text-lg md:text-xl text-gray-700 mb-8 leading-relaxed max-w-2xl mx-auto"
        >
          Solicita tu <span class="font-semibold text-dv-primary"
            >cotización gratuita</span
          > y descubre cómo podemos ayudar a tu empresa con soluciones profesionales
          y confiables.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
          <a
            href="/contacto"
            class="btn-primary inline-flex items-center justify-center gap-3 text-lg px-10 py-5"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>Solicitar Cotización</span>
          </a>
          <a
            href="tel:+56944344320"
            class="px-10 py-5 rounded-xl font-semibold glass hover:bg-white/90 text-dv-primary transition-all duration-300 hover:shadow-md inline-flex items-center justify-center gap-3 text-lg"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <span>Llamar Ahora</span>
          </a>
        </div>

        <div class="border-t border-gray-200 pt-6 mt-6">
          <p class="text-sm text-gray-600 mb-4">O contáctanos directamente:</p>
          <div
            class="flex flex-col sm:flex-row gap-4 justify-center items-center text-sm"
          >
            <a
              href="tel:+56944344320"
              class="flex items-center gap-2 text-dv-primary hover:text-dv-secondary transition-colors"
            >
              <Icon name="phone" class="w-4 h-4" />
              <span>+56 9 4434 4320</span>
            </a>
            <a
              href="https://wa.me/56944344320"
              target="_blank"
              class="flex items-center gap-2 text-dv-primary hover:text-dv-secondary transition-colors"
            >
              <Icon name="message-circle" class="w-4 h-4" />
              <span>WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Scroll Reveal Animation
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document
    .querySelectorAll(".scroll-reveal")
    .forEach((el) => observer.observe(el));

  // Counter Animation
  const animateCounter = (element: HTMLElement) => {
    const target = parseInt(element.getAttribute("data-target") || "0");
    const duration = 2000;
    const increment = target / (duration / 16);
    let current = 0;

    const updateCounter = () => {
      current += increment;
      if (current < target) {
        element.textContent = Math.floor(current).toString();
        requestAnimationFrame(updateCounter);
      } else {
        element.textContent = target.toString();
      }
    };

    updateCounter();
  };

  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const counter = entry.target as HTMLElement;
          animateCounter(counter);
          counterObserver.unobserve(counter);
        }
      });
    },
    { threshold: 0.5 },
  );

  document
    .querySelectorAll(".counter")
    .forEach((el) => counterObserver.observe(el));
</script>
