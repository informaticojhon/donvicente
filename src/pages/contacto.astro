---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contacto - Don Vicente"
  description="Contáctanos para solicitar cotización o más información. Teléfono, email, WhatsApp y ubicación en Melinka, Región de Aysén."
>
  <section class="pb-20">
    <div class="container mx-auto px-4">
      <h2 class="section-title">Contáctanos</h2>

      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-8">
        <!-- Datos de contacto -->
        <div class="glass-card space-y-4 text-gray-700">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📞</span>
            <div>
              <strong class="text-dv-primary">Teléfono:</strong>
              <p>+56 9 1234 5678</p>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <span class="text-2xl">📧</span>
            <div>
              <strong class="text-dv-primary">Correo:</strong>
              <p>contacto@donvicente.cl</p>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <span class="text-2xl">📍</span>
            <div>
              <strong class="text-dv-primary">Dirección:</strong>
              <p>Melinka, Región de Aysén, Chile</p>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <span class="text-2xl">💬</span>
            <div>
              <strong class="text-dv-primary">WhatsApp:</strong>
              <p>
                <a href="https://wa.me/56912345678" target="_blank" class="text-dv-secondary underline hover:text-dv-primary transition-colors">
                  Chatear ahora
                </a>
              </p>
            </div>
          </div>
        </div>

        <!-- Mapa de Google -->
        <div class="glass-card overflow-hidden p-0">
          <iframe 
            class="w-full h-full min-h-[300px] md:min-h-[400px]"
            loading="lazy"
            allowfullscreen
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3261.382956140974!2d-73.7477777!3d-43.8971015!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x962181a20f1f6f6f%3A0x2a6a2b60aa3b3bcb!2sMelinka!5e0!3m2!1ses-419!2scl!4v1624645285564!5m2!1ses-419!2scl"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
