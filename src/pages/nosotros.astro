---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="Sobre Nosotros - Don Vicente Servicios Integrales"
  description="Empresa de Melinka con más de 10 años de experiencia en transporte, aseo industrial, operarios y control de plagas en la Región de Aysén."
>
  <!-- Hero Section -->
  <section
    class="relative py-16 md:py-20 mb-20"
  >

    <div class="container mx-auto px-6 text-center">
      <h1
        class="text-4xl md:text-5xl font-bold text-dv-primary mb-6 tracking-tight leading-tight animate-fade-in animate-delay-100"
      >
        Construyendo Relaciones, Entregando Resultados
      </h1>

      <p
        class="text-xl md:text-2xl text-gray-700 max-w-3xl mx-auto leading-relaxed animate-fade-in animate-delay-200"
      >
        La empresa de servicios integrales que <span
          class="font-semibold text-dv-primary">Aysén necesita</span
        >
      </p>
    </div>
  </section>

  <!-- Quiénes Somos -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
          <!-- Imagen -->
          <div class="">
            <div class="relative group">
              <div class="relative rounded-3xl overflow-hidden shadow-md">
                <img
                  src="/images/industrial.webp"
                  alt="Don Vicente - Empresa de servicios en Aysén"
                  class="w-full h-[600px] object-cover transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            </div>
          </div>

          <!-- Contenido -->
          <div class="" style="animation-delay: 0.1s;">
            <div
              class="inline-flex items-center gap-2 bg-dv-primary/10 px-4 py-2 rounded-full mb-6"
            >
              <Icon name="mountain-snow" class="w-5 h-5 text-dv-primary" />
              <span class="text-sm font-bold text-dv-primary"
                >Desde Aysén para Chile</span
              >
            </div>

            <h2 class="text-4xl md:text-5xl font-bold text-dv-primary mb-6">
              ¿Quiénes Somos?
            </h2>

            <div class="space-y-4 text-gray-700 leading-relaxed">
              <p class="text-lg">
                <strong class="text-dv-primary">Don Vicente</strong> es una empresa
                nacida en el corazón de la Región de Aysén, específicamente en <strong
                  >Melinka</strong
                >, una de las comunas más australes de Chile.
              </p>

              <p>
                Desde nuestros inicios, hemos trabajado con la convicción de que
                los servicios de calidad no son un privilegio de las grandes
                ciudades, sino un derecho de todas las comunidades.
              </p>

              <div
                class="bg-blue-50 border-l-4 border-dv-primary p-6 rounded-r-xl my-6"
              >
                <p class="font-semibold text-dv-primary text-lg">
                  10 años de trayectoria, nos hemos consolidado como un
                  referente en servicios integrales.
                </p>
              </div>

              <p>
                Nuestro compromiso va más allá de cumplir contratos: <span
                  class="text-dv-secondary font-semibold"
                  >construimos relaciones de confianza a largo plazo</span
                > con cada uno de nuestros clientes.
              </p>
            </div>
          </div>
        </div>

        <!-- Línea de Tiempo -->
        <div class="mb-20">
          <h2 class="section-title mb-12">Nuestro Recorrido</h2>

          <div class="relative">
            <div
              class="hidden md:block absolute left-1/2 transform -translate-x-1/2 w-1 h-full bg-slate-300"
            >
            </div>

            <div class="space-y-12">
              <!-- Hito 1 -->
              <div class="relative">
                <div class="md:grid md:grid-cols-2 md:gap-8 items-center">
                  <div class="md:text-right mb-4 md:mb-0">
                    <div class="glass-card inline-block">
                      <div class="text-2xl font-bold text-dv-secondary mb-2">
                        Agosto de 2015
                      </div>
                      <h3 class="text-xl font-bold text-dv-primary mb-2">
                        Nuestros Inicios
                      </h3>
                      <p class="text-gray-700">
                        Fundación de Don Vicente en Melinka, comenzando con
                        servicios de transporte de personal para empresas
                        locales.
                      </p>
                    </div>
                  </div>
                  <div class="hidden md:block"></div>
                </div>
                <div
                  class="hidden md:block absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-6 h-6 bg-dv-primary rounded-full border-4 border-white shadow-sm"
                >
                </div>
              </div>

              <!-- Hito 2 -->
              <div
                class="relative"
                style="animation-delay: 0.1s;"
              >
                <div class="md:grid md:grid-cols-2 md:gap-8 items-center">
                  <div class="hidden md:block"></div>
                  <div class="md:text-left mb-4 md:mb-0">
                    <div class="glass-card inline-block">
                      <div class="text-2xl font-bold text-dv-secondary mb-2">
                        2017
                      </div>
                      <h3 class="text-xl font-bold text-dv-primary mb-2">
                        Expansión de Servicios
                      </h3>
                      <p class="text-gray-700">
                        Incorporamos aseo industrial y control de plagas.
                      </p>
                    </div>
                  </div>
                </div>
                <div
                  class="hidden md:block absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-6 h-6 bg-blue-500 rounded-full border-4 border-white shadow-sm"
                >
                </div>
              </div>

              <!-- Hito 3 -->
              <div
                class="relative"
                style="animation-delay: 0.2s;"
              >
                <div class="md:grid md:grid-cols-2 md:gap-8 items-center">
                  <div class="md:text-right mb-4 md:mb-0">
                    <div class="glass-card inline-block">
                      <div class="text-2xl font-bold text-dv-secondary mb-2">
                        2020
                      </div>
                      <h3 class="text-xl font-bold text-dv-primary mb-2">
                        Crecimiento Regional
                      </h3>
                      <p class="text-gray-700">
                        Alcanzamos clientes activos en toda la Región de Aysén y
                        zonas aledañas.
                      </p>
                    </div>
                  </div>
                  <div class="hidden md:block"></div>
                </div>
                <div
                  class="hidden md:block absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-6 h-6 bg-green-500 rounded-full border-4 border-white shadow-sm"
                >
                </div>
              </div>

              <!-- Hito 4 -->
              <div
                class="relative"
                style="animation-delay: 0.3s;"
              >
                <div class="md:grid md:grid-cols-2 md:gap-8 items-center">
                  <div class="hidden md:block"></div>
                  <div class="md:text-left mb-4 md:mb-0">
                    <div class="glass-card inline-block">
                      <div class="text-2xl font-bold text-dv-secondary mb-2">
                        2025
                      </div>
                      <h3 class="text-xl font-bold text-dv-primary mb-2">
                        Líderes en Servicios Integrales
                      </h3>
                      <p class="text-gray-700">
                        Nuestros clientes se encuentran satisfechos.
                      </p>
                    </div>
                  </div>
                </div>
                <div
                  class="hidden md:block absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-6 h-6 bg-dv-secondary rounded-full border-4 border-white shadow-sm"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nuestro Equipo -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <h2 class="section-title mb-4">Nuestro Equipo</h2>
      <p class="section-subtitle mb-16">
        Profesionales capacitados y comprometidos con la excelencia
      </p>

      <div
        class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto mb-16"
      >
        <div
          class="glass-card text-center group transition-transform"
        >
          <div
            class="w-24 h-24 mx-auto mb-4 bg-dv-primary rounded-full flex items-center justify-center shadow-md group-hover:shadow-md transition-shadow"
          >
            <svg
              class="w-12 h-12 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <div
            class="text-4xl font-extrabold text-dv-primary mb-2"
          >
            50+
          </div>
          <h3 class="text-lg font-bold text-dv-primary mb-2">Colaboradores</h3>
          <p class="text-sm text-gray-700">Equipo multidisciplinario</p>
        </div>

        <div
          class="glass-card text-center group transition-transform"
          style="animation-delay: 0.1s;"
        >
          <div
            class="w-24 h-24 mx-auto mb-4 bg-dv-primary rounded-full flex items-center justify-center shadow-md group-hover:shadow-md transition-shadow"
          >
            <svg
              class="w-12 h-12 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div
            class="text-4xl font-extrabold text-dv-primary mb-2"
          >
            100%
          </div>
          <h3 class="text-lg font-bold text-dv-primary mb-2">Capacitados</h3>
          <p class="text-sm text-gray-700">Formación continua</p>
        </div>

        <div
          class="glass-card text-center group transition-transform"
          style="animation-delay: 0.2s;"
        >
          <div
            class="w-24 h-24 mx-auto mb-4 bg-dv-primary rounded-full flex items-center justify-center shadow-md group-hover:shadow-md transition-shadow"
          >
            <svg
              class="w-12 h-12 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div
            class="text-4xl font-extrabold text-dv-primary mb-2"
          >
            24/7
          </div>
          <h3 class="text-lg font-bold text-dv-primary mb-2">Disponibilidad</h3>
          <p class="text-sm text-gray-700">Atención permanente</p>
        </div>

        <div
          class="glass-card text-center group transition-transform"
          style="animation-delay: 0.3s;"
        >
          <div
            class="w-24 h-24 mx-auto mb-4 bg-dv-primary rounded-full flex items-center justify-center shadow-md group-hover:shadow-md transition-shadow"
          >
            <svg
              class="w-12 h-12 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <div
            class="text-4xl font-extrabold text-dv-primary mb-2"
          >
            10+
          </div>
          <h3 class="text-lg font-bold text-dv-primary mb-2">Años</h3>
          <p class="text-sm text-gray-700">De experiencia</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Nuestro Equipo en Acción -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <h2 class="section-title mb-4">Nuestro Equipo en Acción</h2>
      <p class="section-subtitle mb-16">
        Profesionales comprometidos con la excelencia
      </p>

      <div class="flex flex-wrap justify-center gap-8 max-w-6xl mx-auto">
        <div
          class="glass-card overflow-hidden group w-full md:w-[calc(50%-1rem)]"
        >
          <div class="relative overflow-hidden aspect-[4/3]">
            <img
              src="/images/plagas.webp"
              alt="Equipo trabajando en control de plagas"
              class="w-full h-full object-cover transition-transform duration-500"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-dv-primary/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4 pointer-events-none"
            >
              <p class="text-white font-semibold text-sm">
                Control de Plagas Profesional
              </p>
            </div>
          </div>
        </div>

        <div
          class="glass-card overflow-hidden group w-full md:w-[calc(50%-1rem)]"
          style="animation-delay: 0.1s;"
        >
          <div class="relative overflow-hidden aspect-[4/3]">
            <img
              src="/images/transportecarga.webp"
              alt="Personal en planta industrial"
              class="w-full h-full object-cover transition-transform duration-500"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-dv-primary/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4 pointer-events-none"
            >
              <p class="text-white font-semibold text-sm">
                Transporte de Carga
              </p>
            </div>
          </div>
        </div>

        <div
          class="glass-card overflow-hidden group w-full md:w-[calc(50%-1rem)]"
          style="animation-delay: 0.2s;"
        >
          <div class="relative overflow-hidden aspect-[4/3]">
            <img
              src="/images/operariosindustriales.webp"
              alt="Servicios profesionales certificados"
              class="w-full h-full object-cover transition-transform duration-500"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-dv-primary/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4 pointer-events-none"
            >
              <p class="text-white font-semibold text-sm">
                Servicios Certificados
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compromiso con la Región -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <div class="glass-card">
          <div class="text-center mb-8">
            <h2 class="text-3xl md:text-4xl font-bold text-dv-primary mb-4">
              Compromiso con Aysén
            </h2>
          </div>

          <div class="space-y-4 text-gray-700 leading-relaxed">
            <p>
              Como empresa nacida en <strong>Melinka</strong>, entendemos los
              desafíos únicos de operar en zonas australes. La geografía, el
              clima y las distancias no son obstáculos para nosotros, sino el
              contexto en el que hemos aprendido a destacar.
            </p>
            <p>
              Nuestro compromiso va más allá de lo comercial: <span
                class="text-dv-secondary font-semibold"
                >generamos empleo local, apoyamos iniciativas comunitarias y
                contribuimos al desarrollo económico de la región</span
              >. Cada proyecto que asumimos es una oportunidad para demostrar
              que la calidad y la profesionalidad no tienen fronteras.
            </p>
            <p>
              Trabajamos con empresas pesqueras, instituciones de salud,
              municipalidades, colegios y empresas privadas de diversos rubros.
              Nuestra versatilidad y capacidad de adaptación nos han permitido
              convertirnos en un <strong>socio estratégico confiable</strong> para
              organizaciones de todo tamaño.
            </p>
          </div>

          <div
            class="grid md:grid-cols-3 gap-6 mt-10 pt-8 border-t border-gray-200"
          >
            <div class="text-center">
              <Icon name="factory" class="w-8 h-8 mx-auto mb-2 text-dv-primary" />
              <h3 class="font-semibold text-dv-primary mb-1">
                Sector Industrial
              </h3>
              <p class="text-sm text-gray-700">
                Apoyo a empresas pesqueras y productivas
              </p>
            </div>
            <div class="text-center">
              <Icon name="landmark" class="w-8 h-8 mx-auto mb-2 text-dv-primary" />
              <h3 class="font-semibold text-dv-primary mb-1">Sector Público</h3>
              <p class="text-sm text-gray-700">
                Servicios a municipios y salud
              </p>
            </div>
            <div class="text-center">
              <Icon name="building-2" class="w-8 h-8 mx-auto mb-2 text-dv-primary" />
              <h3 class="font-semibold text-dv-primary mb-1">Sector Privado</h3>
              <p class="text-sm text-gray-700">
                Soluciones para empresas de todo rubro
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certificaciones -->
  <section class="py-20">
    <div class="container mx-auto px-6">
      <h2 class="section-title mb-4">Certificaciones y Cumplimiento</h2>
      <p class="section-subtitle mb-16">
        Operamos bajo los más altos estándares de calidad
      </p>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="glass-card text-center">
          <Icon name="shield-check" class="w-9 h-9 mx-auto mb-3 text-dv-primary" />
          <h3 class="font-bold text-dv-primary mb-2">Seguridad</h3>
          <p class="text-sm text-gray-700">Protocolos de seguridad laboral</p>
        </div>
        <div
          class="glass-card text-center"
          style="animation-delay: 0.1s;"
        >
          <Icon name="leaf" class="w-9 h-9 mx-auto mb-3 text-dv-primary" />
          <h3 class="font-bold text-dv-primary mb-2">Medio Ambiente</h3>
          <p class="text-sm text-gray-700">Prácticas sustentables</p>
        </div>
        <div
          class="glass-card text-center"
          style="animation-delay: 0.2s;"
        >
          <Icon name="clipboard-list" class="w-9 h-9 mx-auto mb-3 text-dv-primary" />
          <h3 class="font-bold text-dv-primary mb-2">Normativa</h3>
          <p class="text-sm text-gray-700">Cumplimiento legal vigente</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <div class="glass-card text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-dv-primary mb-4">
          ¿Quieres ser parte de nuestra historia?
        </h2>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">
          Únete a los cientos de clientes que confían en Don Vicente para sus
          operaciones diarias.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contacto"
            class="btn-primary inline-flex items-center justify-center gap-3"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>Contáctanos</span>
          </a>
          <a
            href="/servicios"
            class="px-8 py-4 rounded-xl font-semibold glass hover:bg-white/90 text-dv-primary transition-all duration-300 hover:shadow-md inline-flex items-center justify-center gap-3"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>Ver Servicios</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document
    .querySelectorAll(".scroll-reveal")
    .forEach((el) => observer.observe(el));
</script>
